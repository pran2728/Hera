# Public Supabase values (safe to ship in the app). Set these in Vercel → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Never put GEMINI_API_KEY here. It lives only in Supabase → Edge Functions → Secrets.
